# Copiá este archivo a ".env" (en Render/Railway se cargan como variables
# de entorno del servicio, no hace falta el archivo en sí) y completá los
# valores reales. NUNCA subas el .env real a GitHub.

# Cualquier texto largo y random. Sirve para firmar las sesiones de login.
SECRET_KEY=cambiame-por-algo-largo-y-random

# Dashboard de Stripe -> Desarrolladores -> Claves de API
STRIPE_SECRET_KEY=sk_test_...

# Dashboard de Stripe -> Desarrolladores -> Webhooks -> tu endpoint -> "Signing secret"
STRIPE_WEBHOOK_SECRET=whsec_...

# Precio del acceso de por vida, en CENTAVOS (9900 = $99.00)
PRICE_CENTS=9900
PRICE_CURRENCY=usd
PRODUCT_NAME=Bitácora Trader -- acceso de por vida
